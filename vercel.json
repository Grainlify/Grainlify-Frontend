{
  "rewrites": [
    {
      "source": "/agent/:path*",
      "destination": "https://agent.grainlify.com/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(signin|signup|auth/callback|support|dashboard|notifications|bounties|bounties/ledger|bounties/link|bounties/rules)",
      "destination": "/index.html"
    },
    {
      "source": "/(signin|signup|auth/callback|support|dashboard|notifications|bounties|bounties/ledger|bounties/link|bounties/rules)/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ]
    }
  ]
}
