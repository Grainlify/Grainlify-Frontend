# Frontend Environment Variables
# Backend API URL - MUST use http:// for local development
# The backend this build talks to. Vite inlines it at BUILD time, so it is
# baked into the bundle rather than read at runtime - changing it needs a
# rebuild, and a wrong value ships silently in the artifact.
#
# Was pointing at an Elastic Beanstalk host that has not existed for months.
# Nothing broke, because nobody copies this file and then wonders why: the
# fallback in src/shared/config/api.ts is localhost:8080, and every real
# deployment sets the variable in Vercel.
#
#   local dev   http://localhost:8080  (this default)
#   deployed    https://api.grainlify.com  (set per-environment in Vercel)
VITE_API_BASE_URL=http://localhost:8080
# Frontend Base URL (optional)
VITE_FRONTEND_BASE_URL=http://localhost:5173# Which chain_configs row the Base payout address card registers against.
# The backend has two enabled Base rows, 'base' (mainnet) and 'base-sepolia'.
# Unset means base-sepolia. Set 'base' only once payouts go to mainnet.
VITE_BASE_PAYOUT_CHAIN_ID=base-sepolia
